{
	"name": "LSG FIT",

	"dockerComposeFile": [
		"../docker-compose.yml",
		"docker-compose.yml"
	],

	"containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "XDG_SESSION_TYPE": "wayland"
  },

  "mounts": ["source=claude-code-config,target=/home/node/.claude,type=volume"],

	"service": "apps",

	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/stuartleeks/dev-container-features/shell-history:0": {},
		"ghcr.io/nils-geistmann/devcontainers-features/zsh:0": {},
		"ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
      "plugins": "git git-flow F-Sy-H zsh-autosuggestions zsh-completions",
      "omzPlugins": "https://github.com/z-shell/F-Sy-H https://github.com/zsh-users/zsh-autosuggestions https://github.com/zsh-users/zsh-completions"
    }
	},

	"postCreateCommand": {
    "fix-permissions": "sudo chown -R node:node /home/node/.claude",
    "install-claude-code": "curl -fsSL https://claude.ai/install.sh | bash"
  }
}
