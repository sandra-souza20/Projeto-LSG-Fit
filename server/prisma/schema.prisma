generator client {
  provider = "prisma-client"
  output   = "../prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String @unique
  password String
  emailVerified Boolean @default(false) @map("email_verified")
  verificationCode String? @map("verification_code")
  verificationCodeExpiresAt DateTime? @map("verification_code_expires_at")
  resetPasswordCode String? @map("reset_password_code")
  resetPasswordCodeExpiresAt DateTime? @map("reset_password_code_expires_at")
  professionalId String? @map("professional_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at")

  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  workoutEntries WorkoutEntry[]

  @@map("users")
}

// Corresponde ao ator "Professor" do DER: cada Professional pode estar vinculado
// a uma Gym (relacao Contrata) e orienta varios alunos (relacao Orienta).
model Professional {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String @unique
  password String
  gymId String? @map("gym_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at")

  gym Gym? @relation(fields: [gymId], references: [id], onDelete: SetNull)
  students User[]

  @@map("professionals")
}

// Corresponde ao ator "Academia" do DER.
model Gym {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String @unique
  password String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at")

  professionals Professional[]

  @@map("gyms")
}

model Exercise {
  id String @id @default(uuid()) @db.Uuid
  name String
  muscleGroup String @map("muscle_group")
  equipment String
  instructions String?
  gifUrl String? @map("gif_url")
  videoUrl String? @map("video_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at")

  workoutEntries WorkoutEntry[]

  @@map("exercises")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model WorkoutEntry {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  exerciseId String @map("exercise_id") @db.Uuid
  dayOfWeek Weekday @map("day_of_week")
  sets Int
  reps Int
  weight Float?
  order Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId, dayOfWeek])
  @@map("workout_entries")
}