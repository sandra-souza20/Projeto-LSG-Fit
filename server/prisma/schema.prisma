generator client {
  provider = "prisma-client"
  output   = "../prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String @unique
  password String
  emailVerified Boolean @default(false) @map("email_verified")
  verificationCode String? @map("verification_code")
  verificationCodeExpiresAt DateTime? @map("verification_code_expires_at")
  resetPasswordCode String? @map("reset_password_code")
  resetPasswordCodeExpiresAt DateTime? @map("reset_password_code_expires_at")
  professionalId String? @map("professional_id") @db.Uuid
  // Relacao "Matricula" do DER: academia em que o aluno treina.
  gymId String? @map("gym_id") @db.Uuid
  gymEnrolledAt DateTime? @map("gym_enrolled_at")
  phone String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at")

  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  gym Gym? @relation(fields: [gymId], references: [id], onDelete: SetNull)
  workoutEntries WorkoutEntry[]
  physicalAssessments PhysicalAssessment[]
  workoutSessions WorkoutSession[]

  @@map("users")
}

// Corresponde ao ator "Professor" do DER: cada Professional pode estar vinculado
// a uma Gym (relacao Contrata) e orienta varios alunos (relacao Orienta).
model Professional {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String @unique
  password String
  gymId String? @map("gym_id") @db.Uuid
  // RF05: dados exibidos na "Pagina de Perfis" para o aluno contatar o profissional.
  phone String?
  specialty String?
  bio String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at")

  gym Gym? @relation(fields: [gymId], references: [id], onDelete: SetNull)
  students User[]
  recordedAssessments PhysicalAssessment[]
  createdExercises Exercise[]

  @@map("professionals")
}

// Corresponde ao ator "Academia" do DER.
model Gym {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String @unique
  password String
  phone String?
  address String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at")

  professionals Professional[]
  students User[]

  @@map("gyms")
}

model Exercise {
  id String @id @default(uuid()) @db.Uuid
  name String
  muscleGroup String @map("muscle_group")
  equipment String
  instructions String?
  gifUrl String? @map("gif_url")
  videoUrl String? @map("video_url")
  // RF08: exercicios da biblioteca padrao (seed) ficam com null; os
  // cadastrados por um profissional guardam quem os criou.
  createdByProfessionalId String? @map("created_by_professional_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at")

  createdByProfessional Professional? @relation(fields: [createdByProfessionalId], references: [id], onDelete: SetNull)
  workoutEntries WorkoutEntry[]

  @@map("exercises")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model WorkoutEntry {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  exerciseId String @map("exercise_id") @db.Uuid
  dayOfWeek Weekday @map("day_of_week")
  sets Int
  reps Int
  weight Float?
  // RF03: tempo de descanso entre as series, em segundos.
  restSeconds Int? @map("rest_seconds")
  order Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId, dayOfWeek])
  @@map("workout_entries")
}

// RF04: cada treino concluido pelo aluno vira um registro, usado para
// calcular a frequencia no mes (e pelo profissional, o controle de frequencia).
model WorkoutSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  dayOfWeek Weekday @map("day_of_week")
  completedAt DateTime @default(now()) @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@map("workout_sessions")
}

// RF07: registro de evolucao fisica do aluno (peso e medidas), que pode ser
// preenchido tanto pelo proprio aluno quanto pelo profissional vinculado.
model PhysicalAssessment {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  recordedByProfessionalId String? @map("recorded_by_professional_id") @db.Uuid
  weight Float
  height Float?
  chest Float?
  waist Float?
  hip Float?
  arm Float?
  thigh Float?
  notes String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordedByProfessional Professional? @relation(fields: [recordedByProfessionalId], references: [id], onDelete: SetNull)

  @@map("physical_assessments")
}