DATABASE_URL=postgres://docker:docker@localhost:5432/lsg_fit

# Sessoes e rate limit (docs/contrato-api.md, secao 2.8)
REDIS_URL=redis://:senha@localhost:6379
# Origem do app web da academia (CORS e checagem de Origin/CSRF)
WEB_ORIGIN=http://localhost:5173
# "false" em desenvolvimento (http); "true" em producao (https)
COOKIE_SECURE=false
# Numero de proxies na frente da API (ex.: 1 em producao); vazio sem proxy
TRUST_PROXY=

RESEND_API_KEY=
EMAIL_FROM=LSG FIT <onboarding@resend.dev>
# "off" dispensa o codigo de confirmacao e libera o cadastro de qualquer e-mail
EMAIL_VERIFICATION=
